rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true); }
    match /public_content/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /campuses/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /news/{document=**} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /events/{document=**} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /gallery/{document=**} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /enquiries/{document=**} { allow create: if request.resource.data.keys().hasOnly(['name','phone','campus','className','message','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.phone is string && request.resource.data.phone.size() > 0; allow read, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
